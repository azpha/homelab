log:
  level: info

runner:
  file: .runner
  capacity: 1
  timeout: 3h
  shutdown_timeout: 0s
  insecure: false
  fetch_timeout: 5s
  fetch_interval: 2s
  labels:
    - "ubuntu-latest:docker://catthehacker/ubuntu:act-latest"
    - "ubuntu-22.04:docker://catthehacker/ubuntu:act-22.04"
    - "ansible:docker://git.alexav.gg/alex/setup-ansible:latest"

container:
  network: "host"
  privileged: true
  force_pull: true
  force_rebuild: false
  require_docker: false
  docker_timeout: 0s
