http:
  middlewares:
    tinyauth:
      forwardauth:
        address: http://tinyauth:3000/api/auth/traefik

  routers:
    jtraefik:
      rule: "Host(`traefik.citadel.fntz.net`)"
      service: jtraefik
      entryPoints:
        - webSecure
      tls:
        certResolver: letsencrypt
    coolify:
      rule: "Host(`coolify.citadel.fntz.net`)"
      service: coolify
      entryPoints:
        - webSecure
      tls:
        certResolver: letsencrypt
    traefik:
      rule: "Host(`traefik.fntz.net`)"
      service: traefik
      entryPoints:
        - webSecure
      tls:
        certResolver: letsencrypt
    homebridge:
      rule: "Host(`bridge.fntz.net`)"
      service: homebridge
      entryPoints:
        - webSecure
      tls:
        certResolver: letsencrypt
    wings:
      rule: "Host(`wings.fntz.net`)"
      service: wings
      entryPoints:
        - webSecure
      tls:
        certResolver: letsencrypt
    
  services:
    jtraefik:
      loadBalancer:
        servers:
          - url: "http://100.105.157.6:8080/"
    coolify:
      loadBalancer:
        servers:
          - url: "http://100.105.157.6:8000/"
    traefik:
      loadBalancer:
        servers:
          - url: "http://172.16.0.44:8080/"
    homebridge:
      loadBalancer:
        servers:
          - url: "http://172.16.0.44:8581/"
    wings:
      loadBalancer:
        servers:
          - url: "http://172.16.0.44:4000/"
        passHostHeader: true